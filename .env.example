# ==============================================================================
# 1. Azure SQL Database Configuration
# ==============================================================================

# Port ของ REST API Server (ค่าเริ่มต้น 8787)
PORT=8787

# รูปแบบที่ 1: ใช้ Connection String โดยตรงจาก Azure Portal (แนะนำ)
# คัดลอกได้จาก Azure Portal -> SQL Database (shedatabase) -> Settings -> Connection strings -> Node.js
# ตัวอย่าง:
# AZURE_SQL_CONNECTION_STRING=Server=tcp:your-server.database.windows.net,1433;Initial Catalog=shedatabase;Persist Security Info=False;User ID=your_username;Password={your_password};MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;
AZURE_SQL_CONNECTION_STRING=

# รูปแบบที่ 2: ระบุแยกทีละค่า
AZURE_SQL_SERVER=your-server.database.windows.net
AZURE_SQL_DATABASE=shedatabase
AZURE_SQL_USER=your_username
AZURE_SQL_PASSWORD=your_password
AZURE_SQL_PORT=1433
AZURE_SQL_ENCRYPT=true
AZURE_SQL_TRUST_CERT=false

# Connection Pool Settings
AZURE_SQL_POOL_MAX=10
AZURE_SQL_POOL_MIN=0


# ==============================================================================
# 2. Azure Blob Storage Configuration (รูปภาพ)
# ==============================================================================

# ชื่อ Container สำหรับเก็บรูปภาพ
AZURE_STORAGE_CONTAINER_NAME=picshesystem

# ชื่อ Storage Account บน Azure Portal (เช่น your-storage-account)
AZURE_STORAGE_ACCOUNT_NAME=your_storage_account

# รูปแบบที่ A: ใช้ Connection String ของ Storage Account (แนะนำที่สุด)
# คัดลอกได้จาก Azure Portal -> Storage accounts -> Security + networking -> Access keys -> Connection string
# ตัวอย่าง: DefaultEndpointsProtocol=https;AccountName=your_storage_account;AccountKey=xxx...;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONNECTION_STRING=

# รูปแบบที่ B: ใช้ Account Key
# คัดลอกได้จาก Azure Portal -> Storage accounts -> Access keys -> Key
AZURE_STORAGE_ACCOUNT_KEY=

# รูปแบบที่ C: ใช้ SAS Token (หากต้องการกำหนดสิทธิ์จำกัดเวลา)
AZURE_STORAGE_SAS_TOKEN=


# ==============================================================================
# 3. SQLite Migration (สำหรับรันย้ายข้อมูลเก่า)
# ==============================================================================
# ที่อยู่ไฟล์ SQLite เดิม (หากไม่ระบุ ระบบจะค้นหาจาก .wrangler ให้อัตโนมัติ)
SQLITE_DB_PATH=
